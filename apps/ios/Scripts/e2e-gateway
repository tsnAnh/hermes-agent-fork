#!/usr/bin/env bash
set -euo pipefail

IOS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$IOS_DIR/../.." && pwd)"
PYTHON="${HERMES_IOS_PYTHON:-$REPO/.venv/bin/python}"
GATEWAY_REPO="${HERMES_IOS_GATEWAY_REPO:-$REPO}"
PROFILES=(bot-alpha bot-beta)
SEED=""

usage() {
  cat <<USAGE
usage: e2e-gateway [--seed parity] [-- command...]
Starts a stub LLM and an isolated, auth-gated gateway in a temp HERMES_HOME with two bot
profiles, then runs the command with HERMES_IOS_E2E_* exported (or prints them and waits
for SIGINT when no command is given). Everything is torn down on exit.

  --seed parity   instead of bot-alpha and bot-beta, create the 8-bot parity roster (default
                  plus 7 bots, Vietnamese bot chats, avatar looks and recency spread) through
                  the real profile and session stores; HERMES_IOS_E2E_PROFILES lists its slugs,
                  default first. See Tools/seed-parity/seed_parity.py.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --seed)
      [ "$#" -ge 2 ] || { echo "--seed needs a value (parity)" >&2; exit 2; }
      SEED="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

case "$SEED" in
  "") ;;
  parity)
    SEED_TOOL="$IOS_DIR/Tools/seed-parity/seed_parity.py"
    SEED_SLUGS="$("$PYTHON" -I "$SEED_TOOL" slugs)"
    IFS=, read -r -a PROFILES <<<"$SEED_SLUGS" ;;
  *) echo "unknown seed: $SEED (supported: parity)" >&2; exit 2 ;;
esac

WORK_DIR="$(mktemp -d /tmp/hermes-ios-e2e.XXXXXX)"
HOME_DIR="$WORK_DIR/home"
STUB_LOG="$WORK_DIR/stub-requests.jsonl"
GATEWAY_LOG="$WORK_DIR/gateway.log"
STUB_OUT="$WORK_DIR/stub.out"
mkdir -p "$HOME_DIR"
GATEWAY_PID=""
STUB_PID=""

stop_pid() {
  local pid="$1"
  [ -n "$pid" ] || return 0
  kill "$pid" 2>/dev/null || return 0
  for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.5; done
  kill -9 "$pid" 2>/dev/null || true
}

cleanup() {
  set +e
  stop_pid "$GATEWAY_PID"
  stop_pid "$STUB_PID"
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

free_port() {
  "$PYTHON" -I -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1])'
}

"$PYTHON" -I "$IOS_DIR/Tools/stub-llm/stub_llm.py" --log "$STUB_LOG" >"$STUB_OUT" 2>&1 &
STUB_PID=$!
for _ in $(seq 40); do
  grep -q '^listening ' "$STUB_OUT" 2>/dev/null && break
  kill -0 "$STUB_PID" 2>/dev/null || { echo "stub exited" >&2; cat "$STUB_OUT" >&2; exit 1; }
  sleep 0.25
done
STUB_PORT="$(awk '/^listening /{print $2; exit}' "$STUB_OUT")"
[ -n "$STUB_PORT" ] || { echo "stub did not start" >&2; exit 1; }
STUB_URL="http://127.0.0.1:$STUB_PORT/v1"

PORT="$(free_port)"
USERNAME="tester"
PASSWORD="$("$PYTHON" -I -c 'import secrets;print(secrets.token_urlsafe(18))')"
SECRET="$("$PYTHON" -I -c 'import secrets;print(secrets.token_hex(32))')"
BASE_URL="http://127.0.0.1:$PORT"

cat >"$HOME_DIR/config.yaml" <<YAML
model:
  provider: custom
  base_url: $STUB_URL
  api_key: stub-key
  default: stub-model
webapp:
  enabled: true
  host: 127.0.0.1
  port: $PORT
  public_url: https://hermes-ios-e2e.example.ts.net
dashboard:
  basic_auth:
    username: $USERNAME
    password: $PASSWORD
    secret: $SECRET
YAML
chmod 600 "$HOME_DIR/config.yaml"

hermes() {
  ( cd "$GATEWAY_REPO" && HERMES_HOME="$HOME_DIR" "$PYTHON" -m hermes_cli.main "$@" )
}

for name in "${PROFILES[@]}"; do
  [ "$name" = "default" ] && continue
  hermes profile create "$name" --no-alias --no-skills >"$WORK_DIR/profile-$name.log" 2>&1 \
    || { echo "profile create $name failed" >&2; cat "$WORK_DIR/profile-$name.log" >&2; exit 1; }
  cat >"$HOME_DIR/profiles/$name/config.yaml" <<YAML
model:
  provider: custom
  base_url: $STUB_URL
  api_key: stub-key
  default: stub-model
YAML
done

GATEWAY_ENV=(HERMES_HOME="$HOME_DIR")
if [ "$SEED" = "parity" ]; then
  GATEWAY_ENV+=(PYTHONPATH="$IOS_DIR/Tools/seed-parity/gateway-doubles" IOS_E2E_PROVIDER_USAGE_URL="${STUB_URL%/v1}")
fi

( cd "$GATEWAY_REPO" && exec env "${GATEWAY_ENV[@]}" "$PYTHON" -m hermes_cli.main gateway run >"$GATEWAY_LOG" 2>&1 ) &
GATEWAY_PID=$!
for _ in $(seq 90); do
  curl -fs "$BASE_URL/api/auth/providers" >/dev/null 2>&1 && break
  kill -0 "$GATEWAY_PID" 2>/dev/null || { echo "gateway exited" >&2; tail -30 "$GATEWAY_LOG" >&2; exit 1; }
  sleep 1
done
curl -fs "$BASE_URL/api/auth/providers" >/dev/null || { echo "gateway not ready" >&2; exit 1; }

export HERMES_IOS_TEST_BASE_URL="$BASE_URL"
export HERMES_IOS_TEST_USERNAME="$USERNAME"
export HERMES_IOS_TEST_PASSWORD="$PASSWORD"
export HERMES_IOS_E2E_HOME="$HOME_DIR"
export HERMES_IOS_E2E_PROFILES="$(IFS=,; echo "${PROFILES[*]}")"
export HERMES_IOS_E2E_STUB_LOG="$STUB_LOG"
export HERMES_IOS_E2E_STUB_URL="$STUB_URL"
export HERMES_IOS_E2E_GATEWAY_LOG="$GATEWAY_LOG"

if [ "$SEED" = "parity" ]; then
  "$PYTHON" -I "$SEED_TOOL" seed --home "$HOME_DIR" --repo "$GATEWAY_REPO" >"$WORK_DIR/seed.log" 2>&1 \
    || { echo "seed parity failed" >&2; cat "$WORK_DIR/seed.log" >&2; exit 1; }
fi

if [ "$#" -eq 0 ]; then
  env | grep '^HERMES_IOS_' | sed 's/^/export /'
  wait "$GATEWAY_PID"
else
  set +e
  "$@"
  STATUS=$?
  set -e
  exit "$STATUS"
fi
