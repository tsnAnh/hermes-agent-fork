#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/common.sh"
load_run
WAIT="${VERIFY_IOS_SLOT_WAIT_SECONDS:-900}"

taken_by_someone_else() {
  [ "$(sim_state "$UDID")" = "Booted" ] && ! owned_udids | grep -qx "$UDID"
}

repick_if_taken() {
  taken_by_someone_else || return 0
  [ -z "${VERIFY_IOS_UDID:-}" ] || die "simulator $UDID is booted by another session; not claiming it. Unset VERIFY_IOS_UDID or point it at a shutdown simulator."
  local next
  next="$(pick_sim)"
  [ -n "$next" ] || die "simulator $UDID was taken by another session and no shutdown iPhone simulator is left to reuse"
  say "simulator $UDID was taken by another session since baseline; switching to $next"
  UDID="$next"
  set_state UDID "$UDID"
}

repick_if_taken
state="$(sim_state "$UDID")"
[ "$state" != "Missing" ] || die "simulator $UDID does not exist"

if [ "$state" = "Booted" ]; then
  set_state SIM_BOOTED_BY_US 1
else
  deadline=$(( $(date +%s) + WAIT ))
  while [ "$(booted_count)" -ge "$MAX_SIMS" ]; do
    [ "$(date +%s)" -lt "$deadline" ] || { booted_sims >&2; die "machine already runs $MAX_SIMS simulators and none was released within ${WAIT}s; not starting another"; }
    say "waiting for a free simulator slot ($(booted_count)/$MAX_SIMS running)"
    sleep 15
  done
  repick_if_taken
  set_state SIM_BOOTED_BY_US 1
  xcrun simctl boot "$UDID"
  xcrun simctl bootstatus "$UDID" >/dev/null
  claimed=0
  for _ in $(seq 30); do
    if bash "$LEDGER" claim "$UDID" --owner "$OWNER" >/dev/null 2>&1; then claimed=1; break; fi
    sleep 2
  done
  [ "$claimed" = 1 ] || die "could not claim $UDID in the device ledger"
fi

if xcrun simctl get_app_container "$UDID" "$BUNDLE_ID" >/dev/null 2>&1; then set_state APP_PREINSTALLED 1; else set_state APP_PREINSTALLED 0; fi
xcrun simctl list devices >"$EVIDENCE/baseline/devices-after-start.txt"
say "simulator ready: $UDID (claimed by $OWNER)"
